FROM node:22-alpine AS dependencies

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY server.js ./

FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./

RUN npm ci --omit=dev

COPY --from=dependencies /app/server.js ./server.js

EXPOSE 3000

USER node

CMD ["node", "server.js"]
